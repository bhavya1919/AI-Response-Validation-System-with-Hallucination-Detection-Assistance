# ==============================================================================
# VeriAI Backend Environment Configuration Template
# ==============================================================================

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=veriai
DATABASE_URL=postgresql+asyncpg://postgres:your_secure_password_here@127.0.0.1:5432/veriai

# Embedding Configuration
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
VECTOR_DIMENSION=384
CHUNK_SIZE=500
CHUNK_OVERLAP=50
SQUAD_SAMPLE_SIZE=500
TRUTHFULQA_SAMPLE_SIZE=500

# LLM Agent Configuration
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-6

# API & Security
API_PREFIX=/api
CORS_ORIGINS=http://localhost:3000,http://localhost:80,http://127.0.0.1:3000
